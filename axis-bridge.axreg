// ───────── BRIDGE_SLABLOCK_V1 — SLA-tiered block writer, PHASE A ISOLATED ────
// AXVERITY_RECLOG_SLA_BLOCK_BUILD_PHASE_A_V1. Implements the design
// AXVERITY_RECLOG_SLA_TIERED_BLOCK_DURABILITY_V1: positional block identity
// (blk-<seq>.bin) until seal, content hash (bytes_hash-identical) at seal,
// SLA-gated tick sweep fsyncing every block with unflushed data (full-block
// seal is an early-exit inside the sweep). Per-thread thread-local state,
// shared-nothing (logbuf.rs pattern). NOT WIRED INTO ANY LIVE PATH — cutover
// requires a separate intent. Identities = sha256(name). See
// src/runtime/slablock.rs.

// slab_open(dir, sla_us, block_bytes) -> Int — open a per-thread SLA block
// writer; sla_us is the EXPLICIT user-selected durability tier.
fn slab_open
  identity 0x321bcc646f61647b1d609f6b3af58acb2b79a9f8a1acdd517274d80ab50b08ce
  kind     leaf
  in       (Text, Int, Int)
  out      Int
  effect   fullIo
  deterministic false
  idempotent    false
end

// slab_append(h, bytes) -> Int — append to the active block, returns the byte
// offset (positional identity). NEVER fsyncs; durability comes from the tick.
fn slab_append
  identity 0x843e0207279ed9b2b35eae3151c88e5d0d8cc8b708e777579d85cb19a7c32b5b
  kind     leaf
  in       (Int, Bytes)
  out      Int
  effect   fullIo
  deterministic false
  idempotent    false
end

// slab_tick(h) -> Int — the SLA tick sweep; -1 if gated (inside the SLA
// window, no I/O), else the number of data fsyncs performed.
// slab_append_raw(h, ptr, off, len) -> Int — slab_append's twin over memory the
// caller already owns: same rotation rule, same running hash, same
// never-fsyncs contract, no Value::Bytes materialised. Returns the record's
// byte offset within the active block.
//
// NOT the per-record raw variant that AXVERITY_EXTENT_WRITE_PATH step 4
// measured and rejected: at a 349 B record the Vec is 12 ns of 2,004 (0.6%),
// because the cost is the write(2). This is the same idea at a different UNIT
// OF WORK — one call carries an accumulated RANGE of tens of thousands of
// records, where the Vec would be a full copy per flush and the write(2) it
// replaces is amortised across everything in it.
// identity = sha256("slab_append_raw").
fn slab_append_raw
  identity 0x149f06e3e5489d7c7a5165265912cfb982755ad98bff7fc4a0f7e1395427b02b
  kind     leaf
  in       (Int, Int, Int, Int)
  out      Int
  effect   fullIo
  deterministic false
  idempotent    false
end

