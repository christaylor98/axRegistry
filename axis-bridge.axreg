// ── Tasks (tasks.rs — spawn / join) ───────────────────────────────────────────
// Distinct in intent from `wait` above. `wait` is a channel MESSAGE PUMP with
// its own subscribe/unsubscribe lifecycle; it knows nothing about who produced
// a message. `spawn`/`join` run one named callee and hand back that call's
// result. Both shapes are wanted; neither subsumes the other.
//
// A Handle is the (handleId, result) pair — see axis-types.axreg. `spawn` fills
// the result slot with Unit; it is populated only on termination of the task's
// thread. `join` is therefore HandleList in, HandleList out.
//
// The callee is a bare fn-ref (FN_REF_IS_CALLEE_ONLY) run on an OS thread, NOT
// an async fn: an async callee would colour every spawnable fn and could not
// occupy the bare-fn-path callee slot the emitter writes.
fn spawn
  identity 0xa04afb368a4946b069ebf8e3ceeeba94ff114ddb477c7b5a5e133c5d52544d43
  kind     leaf
  in       (Fn, Value)
  out      Handle
  effect   fullIo
  deterministic false
  idempotent    false
  callback 0 (Value) -> Value
end

// Builds a HandleList from handles. Same runtime as list_make; a separate
// declaration because HandleList and ValueList have different structural
// identities, so list_make's ValueList result is not admissible to `join`.
// `variadic true` with a ONE-entry `in` means any count, every argument a
// Handle (validation/core_ir.rs step 2a). With `in ()` the elements went
// unchecked and a non-handle reached `join`, which panics on it at run time.
fn handle_list_make
  identity 0xcd4fc0dba1b5965440e5a7a40e1bf8f9fee790eb77dce3629270dd604ac060d9
  kind     leaf
  in       (Handle)
  out      HandleList
  effect   pure
  deterministic true
  idempotent    true
  variadic true
end

// Blocks until EVERY listed task has terminated, so this is also the barrier.
// Results come back in the order asked for, not completion order. Unknown or
// already-joined handles panic rather than returning an absent value.
fn join
  identity 0x58393216032be6257784ac0c6a73efb2a084e27b4cfff1e6acee7b7e6ab93b10
  kind     leaf
  in       (HandleList)
  out      HandleList
  effect   fullIo
  deterministic false
  idempotent    false
end

// ── Recovery-log group commit + ack backpath (oneshot.rs / channels.rs /
//    reclog.rs — AXVERITY_HOTPATH_PARALLEL_DISPATCH_V1) ──────────────────────
// The batched, durable, parallel-dispatch INSERT write path. `oneshot_*` is the
// net-new single-fire ack backpath; `bchan_*` is the bounded, BLOCK-on-full
// channel (distinct from the unbounded channel_send above — that one is
// untouched); `reclog_*` is the group-commit writer that folds the payload WAL
// frame + the PK→name BIND into one batch behind one fsync barrier, then
// signals each caller's oneshot. Identities are sha256(name).
fn oneshot_new
  identity 0x98c7370a9abda5e742eff44379a3a1b157ae038d8194b9c95f57780e4cfbb0e6
