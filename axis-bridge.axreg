// ── Process + UTF-8 predicate (AXVERITY_SHIM_BRIDGE_PRIMS_V1) ─────────────────
// Two primitives, added together for the confined shim, following the TCP block
// below in every respect: synchronous blocking leaf fns, no async/channels
// coupling, identity = sha256(name_utf8) per §5b bootstrap rule.
//
// gap:axverity-shim-admit-needs-process-primitive
// gap:axverity-shim-query-needs-utf8-predicate
//
// proc_run(program, argv) -> Int   spawn, wait, report. Raw capability only —
//   no shell, no retry, no timeout, no argv assembly, no cwd (the child
//   inherits the caller's, which is what makes a chdir primitive unnecessary),
//   no output capture, no classification. FOUR disjoint result bands, and
//   -65..=-255 is reserved and never returned:
//     0..=255   the child exited; this is its exit code
//     -1..=-64  killed by a signal; this is -signum
//     -256      could not be started at all
//     -257      ended, and the OS named neither an exit code nor a signal.
//               Unreachable on unix; the whole of the non-unix fallback.
//   Every returned value is in exactly one band. A failed spawn returns rather
//   than panicking, following tcp_connect's -1 precedent for "the thing you
//   asked for is not there".
//   Impl: axis-codegen-bridge-rs/src/runtime/process.rs
//
// bytes_is_utf8(b) -> Bool         the question bytes_to_text answers by
//   panicking. A predicate, not a lossy converter: the converter exists, the
//   question did not. Shares std::str::from_utf8 with bytes_to_text so the
//   guard cannot drift stricter than the thing it guards.
//   Impl: axis-codegen-bridge-rs/src/runtime/bytes_io.rs

fn proc_run
  identity 0x6a3e90fc526007be4cb17d04083d7197d6fe5373bc56cf89d702c6b8dfdab969
  kind     leaf
  in       (Text, TextList)
  out      Int
  effect   fullIo
  deterministic false
  idempotent    false
end

